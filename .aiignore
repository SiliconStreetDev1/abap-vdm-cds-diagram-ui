# .aiignore

# Dependency directories
# These folders often contain a large number of files from third-party libraries
# that are not part of your direct source code.
node_modules/
libs/
vendor/

# Build & output directories
# These contain generated files, not the source code that creates them.
dist/
build/
out/
.next/
.nuxt/
.output/
.vercel/

# Minified files
# Minified files are hard for humans (and AIs) to read and the unminified
# source is almost always preferable.
*.min.js
*.min.css

# Log files
# Logs are runtime artifacts and usually not relevant for code analysis.
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# IDE & editor configuration
# These are user-specific settings for your code editor.
.vscode/
.idea/
*.swp
*.swo

# Git directory
# This contains the git history and is not source code.
.git/

# Environment variables
# These files often contain secrets and environment-specific configurations.
.env
.env.local
.env.*.local
.env.*

# Package manager lock files
# While important for reproducible builds, they are not source code.
package-lock.json
yarn.lock
pnpm-lock.yaml
composer.lock

# Test and coverage reports
coverage/
.nyc_output/
.coverage/
.coverage.*

# Operating System generated files
.DS_Store
Thumbs.db
