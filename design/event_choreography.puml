@startuml
title VDM Diagrammer - Event Choreography (EventManager & Canvas Events)

skinparam handwritten false
skinparam responseMessageBelowArrow true

participant "Selection Panel\n(Left Controllers)" as Left
participant "EventManager\n(Singleton)" as Bus #FFF9C4
participant "Global\nDocument" as DOM #E3F2FD
participant "Diagram Panel\n(Right Handlers)" as Right
participant "Active\nEngine" as Engine

== 1. OData Render Pipeline ==
Left -> Bus : publish("diagram:renderRequest", payload)\n+ IRenderRequestPayload
Bus -> Right : (DiagramRenderHandler)
Right -> Engine : render()
Engine -> Bus : publish("canvas:ready", { viewId })
Bus -> Right : Commit to Undo Stack (DiagramStateActionHandler)

== 2. Live Format Updating ==
Left -> Bus : publish("diagram:liveFormatUpdate", { engine, format })\n+ Config DTO
Bus -> Right : (DiagramRenderHandler)
Right -> Engine : updateFormat()
Left -> Bus : publish("canvas:formatSliderUpdate", { node_spacing })
Bus -> Right : Sync Spacing Slider UI (CanvasActionHandler)

== 3. Interactive Drill-Down ==
User -> Engine : Double-Clicks Node
Engine -> Bus : publish("diagram:nodeDrillDown", { viewName })\n+ Target CDS Name
Bus -> Left : (SelectionController)
Left -> Left : Save Current State to SessionStateCache
Left -> Bus : publish("diagram:renderRequest", payload)

== 4. Canvas Interactivity (EventManager Routing) ==
User -> DOM : Presses Ctrl+Z
DOM -> Right : BuilderKeyboardStrategy intercepts
Right -> Bus : publish("canvas:undoRequest", { viewId })

User -> Engine : Drags Node
Engine -> Bus : publish("canvas:nodePositionChanged", { nodeId, oldPos, newPos })
Bus -> Left : Mark UI Dirty (SelectionStateHandler)
Bus -> Right : Snapshot State (UndoHandler)

== 5. Video Engine Orchestration ==
Left -> Bus : publish("video:autoPause")\n[Triggered before OData Fetch]
Bus -> Right : VideoRecordHandler systemPause()
Left -> Bus : publish("diagram:renderRequest", payload)
Engine -> Bus : publish("canvas:ready", { viewId })
Bus -> Right : _onCanvasReady listener
Right -> Bus : publish("video:autoResume")
Bus -> Right : VideoRecordHandler systemResume()

@enduml