@startuml
title VDM Diagrammer - Event Choreography (Pub/Sub & DOM Events)

skinparam handwritten false
skinparam responseMessageBelowArrow true

participant "Selection Panel\n(Left Controllers)" as Left
participant "SAPUI5\nEventBus" as Bus #FFF9C4
participant "Global\nDocument" as DOM #E3F2FD
participant "Diagram Panel\n(Right Handlers)" as Right
participant "Active\nEngine" as Engine

== 1. OData Render Pipeline ==
Left -> Bus : publish(EventChannels.DIAGRAM_ENGINE, EventIds.RENDER_REQUEST)\n+ Payload DTO
Bus -> Right : (DiagramRenderHandler)
Right -> Engine : render()
Engine -> DOM : dispatchEvent("CANVAS_READY")
DOM -> Right : Commit to Undo Stack (UndoHandler)

== 2. Live Format Updating ==
Left -> Bus : publish(EventChannels.DIAGRAM_ENGINE, EventIds.LIVE_FORMAT_UPDATE)\n+ Config DTO
Bus -> Right : (DiagramRenderHandler)
Right -> Engine : updateFormat()
Left -> DOM : dispatchEvent("FORMAT_SLIDER_UPDATE")
DOM -> Right : Sync Spacing Slider UI (CanvasActionHandler)

== 3. Interactive Drill-Down ==
User -> Engine : Double-Clicks Node
Engine -> Bus : publish(EventChannels.DIAGRAM_ENGINE, EventIds.NODE_DRILL_DOWN)\n+ Target CDS Name
Bus -> Left : (SelectionController)
Left -> Left : Save Current State to SessionStateCache
Left -> Bus : publish(EventChannels.DIAGRAM_ENGINE, EventIds.RENDER_REQUEST)

== 4. Canvas Interactivity (DOM Decoupling) ==
User -> DOM : Presses Ctrl+Z
DOM -> Right : UndoHandler intercepts
Right -> Engine : applyStateToConfig()

User -> Engine : Drags Node
Engine -> DOM : dispatchEvent("NODE_DRAGGED")
DOM -> Left : Mark UI Dirty (SelectionStateHandler)
DOM -> Right : Snapshot State (UndoHandler)

== 5. Video Engine Orchestration ==
Left -> Bus : publish(EventChannels.VIDEO_RECORDING, EventIds.VIDEO_AUTO_PAUSE)\n[Triggered before OData Fetch]
Bus -> Right : VideoRecordHandler systemPause()
Left -> Bus : publish(EventChannels.DIAGRAM_ENGINE, EventIds.RENDER_REQUEST)
Engine -> DOM : dispatchEvent("CANVAS_READY")
DOM -> Right : _onCanvasReady listener
Right -> Bus : publish(EventChannels.VIDEO_RECORDING, EventIds.VIDEO_AUTO_RESUME)
Bus -> Right : VideoRecordHandler systemResume()

@enduml