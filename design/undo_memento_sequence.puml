@startuml
title Undo Stack (Memento Pattern) Sequence

skinparam handwritten false
skinparam responseMessageBelowArrow true

actor User
participant "Cytoscape\nEngine" as Cy
participant "Undo\nHandler" as Undo
participant "Renderer\n(Facade)" as Renderer
participant "UI5 JSON\nModel" as Model

User -> Cy : Drags Node
activate Cy
Cy -> Undo : DOM Event: NODE_DRAGGED
activate Undo
Undo -> Undo : _onStateChange()\n(300ms Debounce Timer)
Undo -> Renderer : getCanvasState()
activate Renderer
Renderer --> Undo : Memento (JSON Object)
deactivate Renderer
Undo -> Undo : _mStacks[path].push(Memento)\n(Cap at 25 items per view)
deactivate Undo
deactivate Cy

User -> Undo : Presses Ctrl+Z
activate Undo
Undo -> Undo : _mStacks[path].pop()
Undo -> Model : Extract Current Config
Undo -> Renderer : applyStateToConfig(config, Memento)
activate Renderer
Renderer --> Undo : Hydrated Config
deactivate Renderer
Undo -> Model : setProperty(Hydrated Config)
Undo -> Renderer : updateLiveFormat(Hydrated Config)
Renderer -> Cy : Repositions Nodes Visually
deactivate Undo

@enduml