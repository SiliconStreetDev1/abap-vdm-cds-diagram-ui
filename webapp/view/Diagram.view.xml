<mvc:View controllerName="nz.co.siliconstreet.vdmdiagrammer.controller.Diagram"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m" 
    xmlns:core="sap.ui.core"
    xmlns:customData="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1">

        <Toolbar id="toolbarActions" visible="{view>/hasDiagram}">
            <Breadcrumbs id="breadcrumbs" links="{diagramData>/breadcrumbLinks}" currentLocationText="{diagramData>/currentBreadcrumb}" class="sapUiTinyMarginEnd">
                <Link text="{diagramData>name}" press="onBreadcrumbPress" />
            </Breadcrumbs>

            <ToolbarSpacer />
            
            <SearchField id="searchCanvas" placeholder="Locate node..." width="200px" search="onSearchCanvas" visible="{view>/canSearch}" class="sapUiTinyMarginEnd" />

            <ToggleButton id="btnMinimap" icon="sap-icon://map" pressed="{view>/showMinimap}" press="onToggleMinimap" tooltip="Toggle Minimap" type="Transparent" visible="{= ${view>/hasDiagram} &amp;&amp; ${view>/canShowMinimap} }" />

            <Button id="btnFullScreen" icon="{view>/fullScreenIcon}" tooltip="{i18n>ttFullScreen}" press="onToggleFullScreen" type="Transparent" />
            
            <Button id="btnCopy" icon="sap-icon://copy" text="{i18n>btnCopy}" press="onCopySyntax" visible="{= ${diagramData>/engine} !== 'CYTOSCAPE' }" />
            <Button id="btnDownloadSrc" icon="sap-icon://download" text="{i18n>btnDownloadSrc}" press="onDownloadSource" visible="{= ${diagramData>/engine} !== 'CYTOSCAPE' }" />
            <Button id="btnDownloadImg" icon="sap-icon://camera" text="{i18n>btnDownloadImg}" press="onDownloadImage" type="Emphasized" visible="{view>/canExportImg}" />
            <Button id="btnDownloadPng" icon="sap-icon://camera" text="{i18n>btnDownloadPng}" press="onDownloadPng" type="Attention" visible="{view>/canExportImg}" />
            
            <ToolbarSeparator visible="{= ${view>/canExportImg} &amp;&amp; ${ui>/enableVideoRecording} === true }" />
            <ComboBox selectedKey="{view>/videoResolution}" width="150px" visible="{= ${view>/canExportImg} &amp;&amp; ${ui>/enableVideoRecording} === true }">
                <core:Item key="SCREEN" text="{i18n>optResScreen}" />
                <core:Item key="1080P" text="{i18n>optRes1080p}" />
                <core:Item key="720P" text="{i18n>optRes720p}" />
            </ComboBox>
            
            <MenuButton id="btnRecordMenu" icon="sap-icon://record" text="{i18n>btnRecord}" type="Reject" visible="{= ${view>/canExportImg} &amp;&amp; !${view>/isRecording} &amp;&amp; ${ui>/enableVideoRecording} === true }">
                <menu>
                    <Menu itemSelected=".onStartRecording">
                        <MenuItem key="CANVAS" text="{i18n>optRecordCanvas}" icon="sap-icon://video" />
                        <MenuItem key="SCREEN" text="{i18n>optRecordScreen}" icon="sap-icon://sys-monitor" />
                    </Menu>
                </menu>
            </MenuButton>
            <Button icon="sap-icon://media-pause" type="Critical" text="Pause" press="onPauseRecording" visible="{= ${view>/isRecording} &amp;&amp; !${view>/isVideoPaused} }" />
            <Button icon="sap-icon://media-play" type="Accept" text="Resume" press="onResumeRecording" visible="{= ${view>/isRecording} &amp;&amp; ${view>/isVideoPaused} }" />
            <Button icon="sap-icon://stop" type="Accept" text="Stop ({view>/recordingTime})" press="onStopRecording" visible="{view>/isRecording}" />
        </Toolbar>   
    
     <VBox id="diagramContainer" height="100%" width="100%" renderType="Bare" class="diagramWrapper {= ${view>/isSelectMode} ? 'selectModeActive' : '' }">
        
        <dependents>
            <Dialog id="popHiddenNodes" title="Hidden Entities" contentWidth="250px" contentHeight="300px" resizable="true" draggable="true">
                <content>
                    <List id="listHiddenNodes" mode="MultiSelect" items="{view>/hiddenNodesList}">
                        <StandardListItem title="{view>label}" description="{view>id}" />
                    </List>
                </content>
                <buttons>
                    <Button text="Restore Selected" type="Emphasized" press=".onRestoreSelectedNodes" />
                    <Button text="Restore All" type="Transparent" press=".onShowHiddenNodes" />
                    <Button text="Close" press=".onCloseHiddenNodes" />
                </buttons>
            </Dialog>
        </dependents>

        <HBox visible="{view>/isFocusMode}" class="focusBadgeContainer" alignItems="Center" justifyContent="Center">
             <Label text="{view>/focusNodeName}" design="Bold" class="sapUiSmallMarginEnd" />
             <Button icon="sap-icon://chain-link" text="Drill Down" press=".onFocusDrillDown" type="Transparent" class="sapUiTinyMarginEnd" tooltip="Open this view" />
             <core:Icon src="sap-icon://decline" press=".onClearFocus" color="#d32f2f" tooltip="Clear Focus" cursor="pointer" class="actionIcon sapUiTinyMarginBegin" />
        </HBox>

        <HBox visible="{= ${diagramData>/engine} === 'CYTOSCAPE' &amp;&amp; ${view>/hasDiagram} }" class="floatingLayoutActions" alignItems="Center">
            <SegmentedButton id="segInteractionMode" selectedKey="{= ${view>/isSelectMode} ? 'select' : 'pan' }" selectionChange=".onChangeInteractionMode">
                <items>
                    <SegmentedButtonItem key="select" icon="sap-icon://draw-rectangle" tooltip="Box Select Mode" width="3rem" />
                    <SegmentedButtonItem key="pan" icon="sap-icon://move" tooltip="Pan Mode" width="3rem" />
                </items>
            </SegmentedButton>
            
            <Button id="btnInfo" icon="sap-icon://information" press="onShowInfo" customData:infoType="InteractionMode" tooltip="{i18n>ttClickInfo}" visible="{ui>/showHelp}" class="btnIconInfo" />
            
            <Button id="btnSpacing" icon="sap-icon://resize-horizontal" press="onShowSpacing" tooltip="Adjust Node Spacing" class="btnIconBlue" enabled="{= ${ui>/formatCytoscape/layout_algorithm} !== 'preset' }" />
            <core:HTML content='&lt;div style="width: 1px; height: 1.75rem; background: var(--sapContent_ForegroundBorderColor, #e5e5e5); margin: 0 0.25rem;"&gt;&lt;/div&gt;' />
            
            <Button id="btnShowHidden" icon="sap-icon://show" press=".onOpenHiddenNodes" tooltip="Manage Hidden Nodes" visible="{view>/hasHiddenNodes}" class="btnIconOrange" />
            <core:HTML content='&lt;div style="width: 1px; height: 1.75rem; background: var(--sapContent_ForegroundBorderColor, #e5e5e5); margin: 0 0.25rem;"&gt;&lt;/div&gt;' />
            <Button id="btnAddNote" icon="sap-icon://notes" press="onAddNote" tooltip="Add Sticky Note" class="btnIconOrange" enabled="{= !${view>/isDrillDown} }" />
        </HBox>

        <VBox height="100%" width="100%" justifyContent="Center" alignItems="Center" renderType="Bare">
            <IllustratedMessage id="msgEmpty" visible="{= !${view>/hasDiagram} &amp;&amp; !${view>/hasError} }" 
                                illustrationType="sapIllus-SearchEarth" title="{i18n>msgEmptyTitle}" description="{i18n>msgEmptyDesc}" />
            
            <MessageStrip id="msgError" visible="{view>/hasError}" text="{view>/errorText}" type="Error" showIcon="true" class="sapUiMargin" />
            
            <MessageStrip id="msgStale" visible="{= ${ui>/isCanvasStale} === true &amp;&amp; ${view>/hasDiagram} === true }" text="{i18n>msgStaleCanvas}" type="Warning" showIcon="true" class="sapUiMarginTop sapUiMarginBegin sapUiMarginEnd" />
            
            <VBox height="100%" width="100%" renderType="Bare" class="{= ${ui>/isCanvasStale} ? 'staleCanvasContainer' : '' }">
                <core:HTML id="htmlRenderer" />
            </VBox>
        </VBox>
    </VBox>
</mvc:View>