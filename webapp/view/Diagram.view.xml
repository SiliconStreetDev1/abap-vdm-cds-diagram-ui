<mvc:View controllerName="nz.co.siliconstreet.vdmdiagrammer.controller.Diagram"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m" 
    xmlns:core="sap.ui.core"
    xmlns:customData="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1">

        <Toolbar id="toolbarActions" visible="{= ${view>/hasDiagram} || ${ui>/enableVideoRecording} === true }">
            <Breadcrumbs id="breadcrumbs" links="{diagramData>/breadcrumbLinks}" currentLocationText="{diagramData>/currentBreadcrumb}" class="sapUiTinyMarginEnd" visible="{view>/hasDiagram}">
                <Link text="{diagramData>name}" press="onBreadcrumbPress" />
            </Breadcrumbs>

            <ToolbarSpacer />
            
            <Button id="btnStartRecord" icon="sap-icon://record" text="{i18n>btnRecord}" type="Reject" press="onStartRecording" visible="{= ${ui>/enableVideoRecording} === true &amp;&amp; !${ui>/isRecording} &amp;&amp; !${ui>/isCountingDown} &amp;&amp; !${ui>/isWaitingForPermission} &amp;&amp; ${ui>/stealthMode} !== true }" class="sapUiTinyMarginEnd" />

            <HBox visible="{ui>/isWaitingForPermission}" alignItems="Center" class="sapUiTinyMarginEnd">
                <BusyIndicator size="1rem" class="sapUiSmallMarginEnd" />
                <Text text="Waiting for OS permission..." />
            </HBox>

            <HBox visible="{ui>/isCountingDown}" alignItems="Center" class="sapUiTinyMarginEnd">
                <core:Icon src="sap-icon://record" color="#d32f2f" class="sapUiTinyMarginEnd" />
                <Text text="Starting in {ui>/countdownTime}s..." design="Bold" class="sapUiSmallMarginEnd" />
                <Button icon="sap-icon://stop" type="Reject" text="Cancel" press="onStopRecording" />
            </HBox>

            <HBox visible="{= ${ui>/isRecording} === true &amp;&amp; ${ui>/stealthMode} !== true }" alignItems="Center" class="sapUiTinyMarginEnd">
                <core:Icon src="sap-icon://circle-task-2" color="#d32f2f" class="sapUiTinyMarginEnd" />
                <Text text="{ui>/recordingTime}" design="Bold" class="sapUiSmallMarginEnd" />
                <Button icon="sap-icon://media-pause" type="Critical" press="onPauseRecording" visible="{= !${ui>/isVideoPaused} }" class="sapUiTinyMarginEnd" />
                <Button icon="sap-icon://record" type="Accept" press="onResumeRecording" visible="{= ${ui>/isVideoPaused} }" class="sapUiTinyMarginEnd" />
                <Button icon="sap-icon://stop" type="Reject" text="Stop" press="onStopRecording" />
            </HBox>
            
            <ToolbarSeparator visible="{= ${ui>/isRecording} || ${ui>/isCountingDown} || ${ui>/isWaitingForPermission} || ${ui>/enableVideoRecording} === true }" />

            <Button id="btnFullScreen" icon="{view>/fullScreenIcon}" tooltip="{i18n>ttFullScreen}" press="onToggleFullScreen" type="Transparent" visible="{view>/hasDiagram}" />
            
            <Button id="btnCopy" icon="sap-icon://copy" text="{i18n>btnCopy}" press="onCopySyntax" visible="{= ${view>/canExportSource} &amp;&amp; ${view>/hasDiagram} }" />
            <Button id="btnDownloadSrc" icon="sap-icon://download" text="{i18n>btnDownloadSrc}" press="onDownloadSource" visible="{= ${view>/canExportSource} &amp;&amp; ${view>/hasDiagram} }" />
            <Button id="btnDownloadImg" icon="sap-icon://camera" text="{i18n>btnDownloadImg}" press="onDownloadImage" type="Emphasized" visible="{= ${view>/canExportImg} &amp;&amp; ${view>/hasDiagram} }" />
            <Button id="btnDownloadPng" icon="sap-icon://camera" text="{i18n>btnDownloadPng}" press="onDownloadPng" type="Attention" visible="{= ${view>/canExportImg} &amp;&amp; ${view>/hasDiagram} }" />
        </Toolbar>   
    
     <VBox id="diagramContainer" height="100%" width="100%" renderType="Bare" class="diagramWrapper {= ${view>/isSelectMode} ? 'selectModeActive' : '' }">
        
        <dependents>
            <Dialog id="popHiddenNodes" title="Hidden Entities" contentWidth="250px" contentHeight="300px" resizable="true" draggable="true">
                <content>
                    <List id="listHiddenNodes" mode="MultiSelect" items="{view>/hiddenNodesList}">
                        <StandardListItem title="{view>label}" description="{view>id}" />
                    </List>
                </content>
                <buttons>
                    <Button text="Restore Selected" type="Emphasized" press=".onRestoreSelectedNodes" />
                    <Button text="Restore All" type="Transparent" press=".onShowHiddenNodes" />
                    <Button text="Close" press=".onCloseHiddenNodes" />
                </buttons>
            </Dialog>
        </dependents>

        <HBox visible="{view>/isFocusMode}" class="focusBadgeContainer sapUiLargeMarginTop" alignItems="Center" justifyContent="Center">
             <Label text="{view>/focusNodeName}" design="Bold" class="sapUiSmallMarginEnd" />
             <Button icon="sap-icon://chain-link" text="Drill Down" press=".onFocusDrillDown" type="Transparent" class="sapUiTinyMarginEnd" tooltip="Open this view" />
             <core:Icon src="sap-icon://decline" press=".onClearFocus" color="#d32f2f" tooltip="Clear Focus" cursor="pointer" class="actionIcon sapUiTinyMarginBegin" />
        </HBox>

        <HBox visible="{= ${diagramData>/engine} === 'CYTOSCAPE' &amp;&amp; ${view>/hasDiagram} }" class="floatingLayoutActions" alignItems="Center">
            <BusyIndicator size="1rem" visible="{= ${ui>/isFetching} &amp;&amp; ${view>/isFullScreen} }" class="sapUiTinyMarginEnd" tooltip="Processing..." />
            <SearchField id="searchCanvas" placeholder="Locate node..." width="200px" search="onSearchCanvas" visible="{view>/canSearch}" class="sapUiTinyMarginEnd" />
            <ToggleButton id="btnMinimap" icon="sap-icon://map" pressed="{view>/showMinimap}" press="onToggleMinimap" tooltip="Toggle Minimap (Shift+M)" class="btnIconBlue" visible="{= ${view>/hasDiagram} &amp;&amp; ${view>/canShowMinimap} }" />
            <core:HTML content='&lt;div style="width: 1px; height: 1.75rem; background: var(--sapContent_ForegroundBorderColor, #e5e5e5); margin: 0 0.25rem;"&gt;&lt;/div&gt;' />

            <SegmentedButton id="segInteractionMode" selectedKey="{= ${view>/isSelectMode} ? 'select' : 'pan' }" selectionChange=".onChangeInteractionMode">
                <items>
                    <SegmentedButtonItem key="select" icon="sap-icon://draw-rectangle" tooltip="Box Select Mode (V or S)" width="3rem" />
                    <SegmentedButtonItem key="pan" icon="sap-icon://move" tooltip="Pan Mode (H or P)" width="3rem" />
                </items>
            </SegmentedButton>
            
            <Button id="btnInfo" icon="sap-icon://information" press="onShowInfo" customData:infoType="InteractionMode" tooltip="{i18n>ttClickInfo}" visible="{ui>/showHelp}" class="btnIconInfo" />
            
            <Button id="btnUndo" icon="sap-icon://undo" press="onUndo" tooltip="Undo Layout Change (Ctrl+Z)" class="btnIconBlue" />
            <core:HTML content='&lt;div style="width: 1px; height: 1.75rem; background: var(--sapContent_ForegroundBorderColor, #e5e5e5); margin: 0 0.25rem;"&gt;&lt;/div&gt;' />

            <Button id="btnSelectAll" icon="sap-icon://multiselect-all" press=".onSelectAll" tooltip="Select All Visible Nodes (Ctrl+A)" class="btnIconBlue" />
            <core:HTML content='&lt;div style="width: 1px; height: 1.75rem; background: var(--sapContent_ForegroundBorderColor, #e5e5e5); margin: 0 0.25rem;"&gt;&lt;/div&gt;' />

            <ToggleButton id="btnToggleFocus" icon="sap-icon://lightbulb" pressed="{view>/tempFocusMode}" press=".onToggleTempFocusMode" tooltip="Focus Selected Entity (Temporary) (Shift+T)" class="btnIconBlue" enabled="{view>/hasNodeSelected}" visible="{= !${ui>/formatCytoscape/enableFocusMode} }" />
            <core:HTML content='&lt;div style="width: 1px; height: 1.75rem; background: var(--sapContent_ForegroundBorderColor, #e5e5e5); margin: 0 0.25rem;"&gt;&lt;/div&gt;' />

            <Button id="btnSpacing" icon="sap-icon://resize-horizontal" press="onShowSpacing" tooltip="Adjust Node Spacing" class="btnIconBlue" enabled="{= ${ui>/formatCytoscape/layout_algorithm} !== 'preset' }" />
            <core:HTML content='&lt;div style="width: 1px; height: 1.75rem; background: var(--sapContent_ForegroundBorderColor, #e5e5e5); margin: 0 0.25rem;"&gt;&lt;/div&gt;' />
            
            <Button id="btnShowHidden" icon="sap-icon://show" press=".onOpenHiddenNodes" tooltip="Manage Hidden Nodes (Shift+H)" visible="{view>/hasHiddenNodes}" class="btnIconOrange" />
            <core:HTML content='&lt;div style="width: 1px; height: 1.75rem; background: var(--sapContent_ForegroundBorderColor, #e5e5e5); margin: 0 0.25rem;"&gt;&lt;/div&gt;' />
            <Button id="btnAddNote" icon="sap-icon://notes" press="onAddNote" tooltip="Add Sticky Note (Shift+N)" class="btnIconOrange" enabled="{= !${view>/isDrillDown} }" />
        </HBox>

        <VBox height="100%" width="100%" justifyContent="Center" alignItems="Center" renderType="Bare">
            <IllustratedMessage id="msgEmpty" visible="{= !${view>/hasDiagram} &amp;&amp; !${view>/hasError} }" 
                                illustrationType="sapIllus-SearchEarth" title="{i18n>msgEmptyTitle}" description="{i18n>msgEmptyDesc}" />
            
            <MessageStrip id="msgError" visible="{view>/hasError}" text="{view>/errorText}" type="Error" showIcon="true" class="sapUiMargin" />
            
            <MessageStrip id="msgStale" visible="{= ${ui>/isCanvasStale} === true &amp;&amp; ${view>/hasDiagram} === true }" text="{i18n>msgStaleCanvas}" type="Warning" showIcon="true" class="sapUiMarginTop sapUiMarginBegin sapUiMarginEnd" />
            
            <VBox height="100%" width="100%" renderType="Bare" class="{= ${ui>/isCanvasStale} ? 'staleCanvasContainer' : '' }">
                <core:HTML id="htmlRenderer" />
            </VBox>
        </VBox>
    </VBox>
</mvc:View>