<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:customData="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1">
    <VBox width="100%">
        <HBox justifyContent="SpaceBetween" width="100%" alignItems="Center" class="sapUiSmallMarginBottom">
            <Label text="{i18n>lblEnableRecording}" design="Bold" />
            <Switch state="{ui>/enableVideoRecording}" customTextOn="{i18n>lblYes}" customTextOff="{i18n>lblNo}" />
        </HBox>

        <VBox visible="{ui>/enableVideoRecording}" width="100%">
            <HBox justifyContent="SpaceBetween" width="100%" alignItems="Center" class="sapUiTinyMarginBottom">
                <HBox alignItems="Center">
                    <Label text="{i18n>lblStealthMode}" />
                    <core:Icon src="sap-icon://information" class="sapUiTinyMarginBegin" color="#0070f2" visible="{ui>/showHelp}" 
                               press="onShowInfo" customData:infoType="StealthMode" tooltip="{i18n>ttClickInfo}" />
                </HBox>
                <Switch state="{ui>/stealthMode}" customTextOn="{i18n>lblYes}" customTextOff="{i18n>lblNo}" enabled="{= !${ui>/isRecording} &amp;&amp; !${ui>/isCountingDown} &amp;&amp; !${ui>/isWaitingForPermission} }" />
            </HBox>

            <HBox justifyContent="SpaceBetween" width="100%" alignItems="Center" class="sapUiTinyMarginBottom">
                <Label text="Recording Mode" />
                <Select selectedKey="{ui>/recordingModeInput}" width="150px" enabled="{= !${ui>/isRecording} &amp;&amp; !${ui>/isCountingDown} &amp;&amp; !${ui>/isWaitingForPermission} }">
                    <core:Item key="SCREEN" text="Entire Screen" />
                    <core:Item key="CANVAS" text="Diagram Only" />
                </Select>
            </HBox>
            <HBox justifyContent="SpaceBetween" width="100%" alignItems="Center" class="sapUiTinyMarginBottom">
                <Label text="{i18n>lblResolution}" />
                <ComboBox selectedKey="{ui>/videoResolution}" width="150px" enabled="{= !${ui>/isRecording} &amp;&amp; !${ui>/isCountingDown} &amp;&amp; !${ui>/isWaitingForPermission} }">
                    <core:Item key="SCREEN" text="{i18n>optResScreen}" />
                    <core:Item key="1080P" text="{i18n>optRes1080p}" />
                    <core:Item key="720P" text="{i18n>optRes720p}" />
                </ComboBox>
            </HBox>
            <HBox justifyContent="SpaceBetween" width="100%" alignItems="Center" class="sapUiTinyMarginBottom">
                <Label text="Framerate (FPS)" />
                <Select selectedKey="{ui>/videoFps}" width="150px" enabled="{= !${ui>/isRecording} &amp;&amp; !${ui>/isCountingDown} &amp;&amp; !${ui>/isWaitingForPermission} }">
                    <core:Item key="30" text="30 FPS" />
                    <core:Item key="45" text="45 FPS" />
                    <core:Item key="60" text="60 FPS" />
                </Select>
            </HBox>
            <HBox justifyContent="SpaceBetween" width="100%" alignItems="Center" class="sapUiTinyMarginBottom">
                <Label text="Quality (Bitrate)" />
                <Select selectedKey="{ui>/videoQuality}" width="150px" enabled="{= !${ui>/isRecording} &amp;&amp; !${ui>/isCountingDown} &amp;&amp; !${ui>/isWaitingForPermission} }">
                    <core:Item key="LOW" text="Low (Smaller File)" />
                    <core:Item key="MEDIUM" text="Medium" />
                    <core:Item key="HIGH" text="High (Recommended)" />
                    <core:Item key="ULTRA" text="Ultra (Large File)" />
                </Select>
            </HBox>
            <HBox justifyContent="SpaceBetween" width="100%" alignItems="Center" class="sapUiTinyMarginBottom">
                <Label text="Start Delay (sec)" />
                <StepInput value="{ui>/videoDelay}" min="0" max="60" width="150px" enabled="{= !${ui>/isRecording} &amp;&amp; !${ui>/isCountingDown} &amp;&amp; !${ui>/isWaitingForPermission} }" />
            </HBox>
            <HBox justifyContent="SpaceBetween" width="100%" alignItems="Center" class="sapUiSmallMarginBottom">
                <Label text="Max Length (sec)" />
                <StepInput value="{ui>/videoMaxLength}" min="10" max="3600" width="150px" enabled="{= !${ui>/isRecording} &amp;&amp; !${ui>/isCountingDown} &amp;&amp; !${ui>/isWaitingForPermission} }" />
            </HBox>

            <VBox width="100%" class="sapUiSmallMarginBottom" visible="{= ${ui>/recordingModeInput} === 'CANVAS' }">
                <Label text="Video Title (Burned in)" class="sapUiTinyMarginBottom" />
                <Input value="{ui>/videoTitle}" placeholder="e.g. Sales Order Architecture" enabled="{= !${ui>/isRecording} &amp;&amp; !${ui>/isCountingDown} &amp;&amp; !${ui>/isWaitingForPermission} }" />
                
                <Label text="Video Subtitle" class="sapUiTinyMarginTop sapUiTinyMarginBottom" />
                <Input value="{ui>/videoSubtitle}" placeholder="Enter a brief description..." enabled="{= !${ui>/isRecording} &amp;&amp; !${ui>/isCountingDown} &amp;&amp; !${ui>/isWaitingForPermission} }" />
            </VBox>
        </VBox>
    </VBox>
</core:FragmentDefinition>